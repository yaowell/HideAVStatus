#!/bin/sh

BACKUP_DIR="/var/mobile/Library/HideAVControlsBackup"

AUDIO="/var/Managed Preferences/mobile/com.apple.replaykit.AudioConferenceControlCenterModule.plist"
VIDEO="/var/Managed Preferences/mobile/com.apple.replaykit.VideoConferenceControlCenterModule.plist"

AUDIO_BACKUP="$BACKUP_DIR/AudioConferenceControlCenterModule.plist"
VIDEO_BACKUP="$BACKUP_DIR/VideoConferenceControlCenterModule.plist"

AUDIO_ABSENT="$BACKUP_DIR/AudioConferenceControlCenterModule.absent"
VIDEO_ABSENT="$BACKUP_DIR/VideoConferenceControlCenterModule.absent"


mkdir -p "$BACKUP_DIR"


# =========================
# Audio
# =========================

if [ ! -f "$AUDIO_BACKUP" ] && [ ! -f "$AUDIO_ABSENT" ]; then

    if [ -f "$AUDIO" ]; then
        cp -p "$AUDIO" "$AUDIO_BACKUP"
    else
        touch "$AUDIO_ABSENT"
    fi

fi


# =========================
# Video
# =========================

if [ ! -f "$VIDEO_BACKUP" ] && [ ! -f "$VIDEO_ABSENT" ]; then

    if [ -f "$VIDEO" ]; then
        cp -p "$VIDEO" "$VIDEO_BACKUP"
    else
        touch "$VIDEO_ABSENT"
    fi

fi


# =========================
# 立即隐藏两个模块
# =========================

/var/jb/usr/bin/HideAVControls --hide 2>/dev/null || true


# 让系统重新读取配置
killall -9 cfprefsd SpringBoard 2>/dev/null || true

exit 0